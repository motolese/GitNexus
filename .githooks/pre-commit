#!/usr/bin/env bash
# Minimal shared discipline (doc-aware): CODE-only size cap + secret scan.
# Docs/data (.md/.json/.sql/...) are exempt from the omnibus cap.
# Gates operate only in their own repo — no cross-repo node/parity gates.
set -euo pipefail
staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

DOC_RE='\.(md|markdown|json|jsonl|txt|sql|html|svg|mmd|csv|rst|adoc|toml|yaml|yml|conf|ini|lock|tsv)$'
code=$(printf '%s\n' "$staged" | grep -viE "$DOC_RE" || true)
ncode=0; [ -n "$code" ] && ncode=$(printf '%s\n' "$code" | grep -c .)
if [ "$ncode" -gt 10 ] && [ "${BITCOINIZE_SKIP_SIZE_LIMIT:-0}" != 1 ]; then
  echo "[SIZE-GATE] BLOCK: $ncode CODE files (limit 10; docs exempt). Split or BITCOINIZE_SKIP_SIZE_LIMIT=1."
  exit 1
fi

if printf '%s\n' "$staged" | grep -qiE '\.(env|pgpass|key|pem|age|gpg|enc)$|ml_token\.json'; then
  echo "[NO-SECRETS] BLOCK: secret-like file staged."
  exit 1
fi

# Credential KEY followed by an actual value (avoids matching bare words).
SECRET_RE='(access_token|refresh_token|client_secret|api[_-]?key|secret[_-]?key)[":= ]+[A-Za-z0-9._-]{8,}|BEGIN [A-Z ]*PRIVATE KEY'
if git diff --cached -U0 | grep -E '^\+' | grep -qiE "$SECRET_RE"; then
  echo "[NO-SECRETS] BLOCK: credential-like content staged."
  exit 1
fi

exit 0
